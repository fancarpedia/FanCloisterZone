# Local, developer-only settings. Copy this file to .env and fill in the values.
# .env is gitignored — nothing here is bundled into the desktop or web build.

# User-Agent the locale download scripts send to wikicarpedia.com
# (dev-utils/update-locales.js and update-locales-download.js — see dev-utils/user-agent.js).
# Use the value the wiki operator allowlists past the Anubis bot gate; without it the scripts
# fall back to a neutral FanCloisterZone/<version> token, which the gate is likely to reject.
FCZ_USER_AGENT=
